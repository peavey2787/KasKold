# Keep generated/vendor-heavy trees classified consistently in repository browsers.
apps/kaskold-companion-web/web/lib/** linguist-vendored

# Text normalization.
* text=auto
*.sh text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.pdf binary

# Hashed into the signed firmware manifest; bytes must not vary by checkout.
apps/kaskold-hardware/partitions/*.csv text eol=lf
